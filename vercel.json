{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "regions": [
    "gru1"
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "obr-desafio-tecnico.vercel.app"
        }
      ],
      "destination": "/desafio-tecnico",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/ranking",
      "destination": "/ranking/index.html"
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "obr-desafio-tecnico.vercel.app"
        }
      ],
      "destination": "/desafio/index.html"
    },
    {
      "source": "/juiz",
      "has": [
        {
          "type": "host",
          "value": "obr-desafio-tecnico.vercel.app"
        }
      ],
      "destination": "/desafio/index.html"
    },
    {
      "source": "/desafio-tecnico",
      "destination": "/desafio/index.html"
    },
    {
      "source": "/coordenacao",
      "destination": "/coordenacao/index.html"
    },
    {
      "source": "/superteams/resgate",
      "destination": "/superteams/resgate/index.html"
    },
    {
      "source": "/voluntarios",
      "destination": "/voluntarios/index.html"
    },
    {
      "source": "/mapa",
      "destination": "/mapa/index.html"
    },
    {
      "source": "/materiais",
      "destination": "/materiais/index.html"
    },
    {
      "source": "/superteams",
      "destination": "/superteams/index.html"
    },
    {
      "source": "/duvidas",
      "destination": "/duvidas/index.html"
    },
    {
      "source": "/sugestoes",
      "destination": "/sugestoes/index.html"
    },
    {
      "source": "/n1",
      "destination": "/app.html"
    },
    {
      "source": "/n2",
      "destination": "/app.html"
    },
    {
      "source": "/agendar",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}

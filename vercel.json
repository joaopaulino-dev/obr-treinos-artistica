{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "regions": [
    "gru1"
  ],
  "rewrites": [
    {
      "source": "/mapa",
      "destination": "/mapa/index.html"
    },
    {
      "source": "/materiais",
      "destination": "/materiais/index.html"
    },
    {
      "source": "/superteams",
      "destination": "/superteams/index.html"
    },
    {
      "source": "/duvidas",
      "destination": "/duvidas/index.html"
    },
    {
      "source": "/sugestoes",
      "destination": "/sugestoes/index.html"
    },
    {
      "source": "/n1",
      "destination": "/app.html"
    },
    {
      "source": "/n2",
      "destination": "/app.html"
    },
    {
      "source": "/agendar",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}

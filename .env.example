# String de conexão do Neon (a integração Neon da Vercel preenche sozinha)
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Senha que a coordenação usa para liberar vagas (abra /n1?coordenacao ou /n2?coordenacao)
ADMIN_PASSWORD=troque-esta-senha

# Opcional: senha separada para zerar as reservas do dia (sem ela, vale ADMIN_PASSWORD)
MASTER_PASSWORD=troque-esta-senha-master
